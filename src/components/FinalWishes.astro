---
import SectionTitle from './SectionTitle.astro';
import Img from './Img.astro';
import Icon from './Icon.astro';
import { wishes } from '../data/site';
import finalBg from '../assets/backgrounds/final-wishes.png';

// soft golden motes — deterministic positions so SSR output is stable
const motes = Array.from({ length: 16 }, (_, i) => {
  const r = (n: number) => ((Math.sin((i + 1) * n) * 10000) % 1 + 1) % 1;
  return {
    x: (r(12.9898) * 100).toFixed(1),
    y: (40 + r(78.233) * 60).toFixed(1),
    s: (2 + r(3.7) * 4).toFixed(1),
    d: (11 + r(9.1) * 9).toFixed(1),
    delay: (-r(5.3) * 20).toFixed(1),
    o: (0.25 + r(2.2) * 0.45).toFixed(2),
  };
});
---

<section class="wishes" id="wishes" aria-labelledby="wishes-title" data-reveal-group>
  <div class="wishes__bg" data-reveal="bg" style="--i:0">
    <Img
      src={finalBg}
      alt=""
      widths={[640, 941]}
      sizes="(min-width: 768px) 100vw, 430px"
      class="wishes__img"
    />
  </div>
  <div class="wishes__shade" aria-hidden="true"></div>
  <div class="wishes__motes decor" aria-hidden="true">
    {
      motes.map((m) => (
        <span
          style={`--x:${m.x}%;--y:${m.y}%;--s:${m.s}px;--d:${m.d}s;--delay:${m.delay}s;--o:${m.o}`}
        />
      ))
    }
  </div>

  <div class="wishes__inner">
    <SectionTitle
      id="wishes-title"
      lines={wishes.titleLines}
      eyebrow={wishes.eyebrow}
      rule={false}
      class="wishes__head"
    />

    {
      [
        { lines: wishes.body, variant: 'wide' },
        { lines: wishes.bodyMobile, variant: 'narrow' },
      ].map(({ lines, variant }) => (
        <p class={`wishes__body wishes__body--${variant}`}>
          {lines.map((line, i) => (
            <span class="wishes__line" data-reveal="up" style={`--i:${i + 3};--stagger:var(--stagger-copy)`}>
              {line}{' '}
            </span>
          ))}
        </p>
      ))
    }

    <p class="wishes__signature" data-reveal="mask" style="--i:9">
      <span>{wishes.signature[0]}</span>
      <span>{wishes.signature[1]}</span>
    </p>

    <div class="wishes__heart" data-reveal="up" style="--i:12">
      <Icon name="heart" size={30} strokeWidth={1.3} />
    </div>
  </div>
</section>
